# ─── Required ─────────────────────────────────────────────────────────────────

# PostgreSQL
DATABASE_URL=postgresql://twork:CHANGE_ME@postgres:5432/twork
POSTGRES_PASSWORD=CHANGE_ME

# MinIO / S3
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME_MIN_12_CHARS
S3_BUCKET=twork
S3_REGION=us-east-1
# S3_ENDPOINT is set per-service in docker-compose.yml (http://minio:9000 internally)

# ─── Auth ─────────────────────────────────────────────────────────────────────

# Public URL — must match the domain your browser uses to reach TWork.
# Used for WebAuthn origin validation. No trailing slash.
PUBLIC_URL=https://twork.example.com

# WebAuthn Relying Party — must match the hostname in PUBLIC_URL.
RP_ID=twork.example.com
RP_NAME=TWork

# For LAN / NAS without a real domain, use:
# PUBLIC_URL=http://192.168.1.100
# RP_ID=192.168.1.100

# ─── Caddy ────────────────────────────────────────────────────────────────────

# Domain Caddy will listen on and obtain a TLS certificate for.
PUBLIC_DOMAIN=twork.example.com

# ─── Mail (Phase 1 — Post module) ─────────────────────────────────────────────
# RESEND_API_KEY=re_...
# MAILGUN_API_KEY=...
# MAILGUN_DOMAIN=mail.example.com

# ─── Seed ─────────────────────────────────────────────────────────────────────
SEED_EMAIL=admin@twork.local
SEED_NAME=Admin
SEED_PROJECT=twork
