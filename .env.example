# ── Required ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-secret

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=ybot
POSTGRES_USER=ybot
POSTGRES_PASSWORD=ybotSecret123

# ── Redis / Valkey ────────────────────────────────────────────────────────────
REDIS_PASSWORD=valkey123

# ── MinIO / S3 ────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=ybotadmin
MINIO_ROOT_PASSWORD=ybotSecret123
S3_ENDPOINT=http://minio:9000
S3_BUCKET=ybot-uploads
S3_REGION=us-east-1

# ── LLM — provide at least ONE key ───────────────────────────────────────────
# Free options:
GROQ_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# Paid options:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost
VITE_API_URL=/api/v1

# ── Docker volume paths (override for Synology NAS) ──────────────────────────
# PGDATA_PATH=/volume1/docker/ybot/pgdata
# VALKEY_PATH=/volume1/docker/ybot/valkey
# MINIO_PATH=/volume1/docker/ybot/minio

# ── Ports ─────────────────────────────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
